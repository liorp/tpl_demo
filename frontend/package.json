{
  "name": "tpl-signum-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:clean": "rm -rf ./dist && mkdir -p ./dist/asset",
    "build:js": "bun build ./src/main.tsx --target browser --define __TPL_BACKEND_PORT__='\"${TPL_BACKEND_PORT:-}\"' --outfile ./dist/asset/main.js --minify",
    "build:css": "bunx --bun @tailwindcss/cli -i ./src/style/globals.css -o ./dist/asset/index.css --minify",
    "build:html": "cp ./index.html ./dist/index.html",
    "build": "bun run build:clean && bun run build:js && bun run build:css && bun run build:html",
    "watch:js": "bun build ./src/main.tsx --target browser --define __TPL_BACKEND_PORT__='\"${TPL_BACKEND_PORT:-}\"' --outfile ./dist/asset/main.js --minify --watch",
    "watch:css": "bunx --bun @tailwindcss/cli -i ./src/style/globals.css -o ./dist/asset/index.css --watch",
    "watch": "bun run build:clean && bun run build:html && bunx --bun concurrently -k -n JS,CSS -c magenta,blue \"bun run watch:js\" \"bun run watch:css\"",
    "format": "biome format --write .",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "@react-leaflet/core": "^3.0.0",
    "@tailwindcss/cli": "^4.1.18",
    "@tanstack/react-query": "^5.90.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.564.0",
    "radix-ui": "^1.4.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-leaflet": "^5.0.0",
    "tailwind-merge": "^3.4.1",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^25.2.3",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "concurrently": "^9.2.1",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}

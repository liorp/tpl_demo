{
  "name": "tpl-demo",
  "private": true,
  "packageManager": "bun@1.3.2",
  "scripts": {
    "dev": "bunx --bun concurrently -k -n FE,BE -c cyan,green \"bun run dev:frontend\" \"bun run dev:backend\"",
    "dev:frontend": "cd frontend && bun run watch",
    "dev:backend": "uv run --project backend uvicorn backend.main:app --host 0.0.0.0 --port 8080 --reload",
    "build": "cd frontend && bun run build",
    "lint": "cd frontend && bun run lint",
    "test:frontend": "cd frontend && bun run test",
    "test:backend": "uv run --project backend pytest",
    "test": "bun run test:frontend && bun run test:backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
